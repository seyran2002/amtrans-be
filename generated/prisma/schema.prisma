// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  OPERATOR
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum OrderStatus {
  UNDER_REVIEW
  PENDING_ESTIMATE
  REGISTERED
  CANCELLED
  REJECTED
  FOREIGN_WAREHOUSE
  IN_TRANSIT
  ARRIVED
  READY
  DELIVERED
}

enum Currency {
  USD
  AED
  EUR
  RUB
  AMD
}

model SystemSetting {
  id                String @id @default("default")
  volumetricDivisor Int    @default(5000)
}

model User {
  id String @id @default(uuid())

  email    String @unique
  password String

  firstName String?
  lastName  String?

  isIndividual Boolean @default(true)
  isSupporter  Boolean @default(false)

  hyDocumentType String?
  enDocumentType String?
  ruDocumentType String?
  documentNumber String?

  companyName String?
  taxpayerId  String?

  address     String?
  phoneNumber String?

  telegramChatId  String?
  receivers       Receiver[]
  orders          Order[]
  estimatedOrders Order[]    @relation("OrderEstimatedBy")

  supportChat SupportChat?

  code String?

  role   Role       @default(CUSTOMER)
  status UserStatus @default(PENDING)

  officeId String?
  office   Office? @relation(fields: [officeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([officeId])
}

// Enums
enum SenderType {
  CUSTOMER
  SUPPORTER
}

enum ChatStatus {
  OPEN
  RESOLVED
  ARCHIVED
}

// New Models
model SupportChat {
  id        String           @id @default(uuid())
  userId    String           @unique
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    ChatStatus       @default(OPEN)
  messages  SupportMessage[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model SupportMessage {
  id         String      @id @default(uuid())
  chatId     String
  chat       SupportChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderType SenderType
  senderId   String
  text       String
  isRead     Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@index([chatId])
}

model Receiver {
  id     String @id @default(uuid())
  userId String

  code           String?
  firstName      String?
  lastName       String?
  hyDocumentType String?
  enDocumentType String?
  ruDocumentType String?
  documentNumber String?
  address        String?
  phoneNumber    String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders         Order[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model Country {
  id String @id @default(uuid())

  hyName String?
  ruName String?
  enName String?
  icon   String?

  offices Office[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enName])
}

model Office {
  id String @id @default(uuid())

  countryId String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Restrict)

  province    String
  city        String
  postalCode  String
  fullAddress String
  phone       String

  operators User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordersFrom      Order[]  @relation("OrderFromOffice")
  ordersTo        Order[]  @relation("OrderToOffice")
  outgoingTariffs Tariff[] @relation("TariffFromOffice")
  incomingTariffs Tariff[] @relation("TariffToOffice")

  @@index([countryId])
  @@index([city])
}

model Tariff {
  id           String   @id @default(uuid())
  fromOfficeId String
  toOfficeId   String
  pricePerKg   Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  fromOffice Office @relation("TariffFromOffice", fields: [fromOfficeId], references: [id], onDelete: Restrict)
  toOffice   Office @relation("TariffToOffice", fields: [toOfficeId], references: [id], onDelete: Restrict)

  @@index([fromOfficeId, toOfficeId])
}

model Order {
  id String @id @default(uuid())

  fromOfficeId String
  toOfficeId   String
  userId       String?
  receiverId   String?

  productPrice       Decimal  @db.Decimal(12, 2)
  price              Decimal  @default(0) @db.Decimal(12, 0)
  pieceCount         Int      @default(1)
  currency           Currency
  marketName         String
  productDescription String
  invoiceUrl         String?
  comment            String?
  tnVedCode          String?
  isNew              Boolean  @default(true)

  weight Decimal @db.Decimal(10, 3)
  length Decimal @db.Decimal(10, 2)
  width  Decimal @db.Decimal(10, 2)
  height Decimal @db.Decimal(10, 2)

  tariffRateAtBooking Decimal? @db.Decimal(12, 2)

  estimatedPrice Decimal?  @db.Decimal(12, 2)
  estimatedById  String?
  estimatedAt    DateTime?
  estimatedBy    User?     @relation("OrderEstimatedBy", fields: [estimatedById], references: [id], onDelete: SetNull)

  qrCode         String?
  trackingNumber String      @unique
  status         OrderStatus @default(UNDER_REVIEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromOffice Office    @relation("OrderFromOffice", fields: [fromOfficeId], references: [id], onDelete: Restrict)
  toOffice   Office    @relation("OrderToOffice", fields: [toOfficeId], references: [id], onDelete: Restrict)
  user       User?     @relation(fields: [userId], references: [id], onDelete: Restrict)
  receiver   Receiver? @relation(fields: [receiverId], references: [id], onDelete: Restrict)

  @@index([fromOfficeId])
  @@index([toOfficeId])
  @@index([userId])
  @@index([receiverId])
  @@index([estimatedById])
  @@index([status])
  @@index([createdAt])
}
